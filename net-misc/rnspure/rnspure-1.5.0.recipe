SUMMARY="Pure python implementation of the Reticulum Network Stack"
DESCRIPTION="It's reticulum!"
HOMEPAGE="https://reticulum.network"
COPYRIGHT="2016-2026 Mark Qvist"
LICENSE="Reticulum"
REVISION="1"
SOURCE_URI="https://deftly.net/dist/rns-$portVersion.tar.gz"
CHECKSUM_SHA256="6c7ded4e78ff6f132814de1c4e032d884a17646a222e98bca80d8d8bc62c5486"
SOURCE_DIR="rns-$portVersion"

ARCHITECTURES="any"

PROVIDES="
	$portName = $portVersion
	cmd:rnsd = $portVersion
	cmd:rngit = $portVersion
	cmd:git_remote_rns = $portVersion
	cmd:rncp = $portVersion
	cmd:rngcs = $portVersion
	cmd:rnid = $portVersion
	cmd:rnir = $portVersion
	cmd:rnodeconf = $portVersion
	cmd:rnpath = $portVersion
	cmd:rnpkg = $portVersion
	cmd:rnprobe = $portVersion
	cmd:rnsh = $portVersion
	cmd:rnstatus = $portVersion
	cmd:rnx = $portVersion
	"

REQUIRES="
	haiku$secondaryArchSuffix
	"
BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	gcc$secondaryArchSuffix
	"

TEST_REQUIRES="
	pytest_$pythonPackage
	"

PYTHON_VERSIONS=(3.10 3.14)

for i in "${!PYTHON_VERSIONS[@]}"; do
	pythonVersion=${PYTHON_VERSIONS[$i]}
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_${pythonPackage}=\"
		${portName}_$pythonPackage = $portVersion
		\""

	if [ "$targetArchitecture" = x86_gcc2 ]; then
		eval "PROVIDES_${pythonPackage}+=\"
			sqlalchemy_$pythonPackage = $portVersion
			\""
	fi

	eval "REQUIRES_$pythonPackage=\"
		haiku$secondaryArchSuffix
		cmd:python$pythonVersion
		\""
	BUILD_REQUIRES+="
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

BUILD()
{
	for i in "${!PYTHON_VERSIONS[@]}"; do
		pythonVersion=${PYTHON_VERSIONS[$i]}
		pythonPackage=python${pythonVersion//.}

		rm -rf "$sourceDir"-$pythonPackage
		cp -a "$sourceDir" "$sourceDir"-$pythonPackage
		cd "$sourceDir"-$pythonPackage

		python=python$pythonVersion
		$python setup.py build --pure
	done
}

INSTALL()
{
	for i in "${!PYTHON_VERSIONS[@]}"; do
		pythonVersion=${PYTHON_VERSIONS[$i]}
		pythonPackage=python${pythonVersion//.}

		cd "$sourceDir"-$pythonPackage

		python=python$pythonVersion
		installLocation=$prefix/lib/$python/vendor-packages/

		export PYTHONPATH=$installLocation
		mkdir -p "$installLocation"

		$python setup.py install \
			--root=/ --prefix="$prefix"


		packageEntries $pythonPackage "$prefix"/lib/$python
	done
}

TEST()
{
	pytest-$pythonVersion -v -m "not download"
}
